#usda 1.0
(
    defaultPrim = "World"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def Cube "GroundPlane" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.35, 0.35, 0.35)]
        double size = 1
        float3 xformOp:scale = (10, 10, 0.1)
        double3 xformOp:translate = (0, 0.2, -0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def DomeLight "DomeLight"
    {
        float inputs:intensity = 1000
    }

    def Scope "Physics"
    {
        def Material "painted_steel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0.05
            float physics:staticFriction = 0.4
        }
    }

    def Xform "Cabinet" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        prepend references = @../../medicine_cabinet/MedicineCabinet.usd@</MedicineCabinet_V6>
