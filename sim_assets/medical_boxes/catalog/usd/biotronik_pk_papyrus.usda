    def Scope "Physics"
    {
        def Material "cardboard" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0.05
            float physics:staticFriction = 0.35
