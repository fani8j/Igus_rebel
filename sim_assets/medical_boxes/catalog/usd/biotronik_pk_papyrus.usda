    def Scope "Looks"
    {
        def Material "front"
        {
            token outputs:surface.connect = </biotronik_pk_papyrus/Looks/front/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </biotronik_pk_papyrus/Looks/front/diffuseTexture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }

            def Shader "stReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "diffuseTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../textures/biotronik_pk_papyrus/front.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </biotronik_pk_papyrus/Looks/front/stReader.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }
