def Xform "left_suction_tool" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    assetInfo = {
        string name = "left_suction_tool"
        string version = "2.0.0"
    }
    customData = {
        string generator_version = "2.0.0"
        double mass_kg = 0.20381
        string source = "cad/medical_box_tooling_v1/suction_tool_v5 (urdf/left_suction_tool.urdf.xacro, meshes/, data/mass.json)"
    }
    doc = "Left-arm suction/scan end effector in the ReBeL link6 frame (metres, +Z out of the flange). Articulation (root on this prim): rigid body `base` + 3 pad heads `pad_{1,2,3}` on prismatic buffer joints (+Z, 10 mm, spring 1..3 N) + an Isaac Sim IsaacSurfaceGripper (`surface_gripper`) with 3 D6 attachment points (`joints/pad_{1,2,3}_attachment`). Frames: suction_tcp, suction_tcp_compressed, wrist_camera_mount, wrist_camera_color_optical_frame, pad_{1,2,3}_suction_frame (pad lip centres, +Z out of the lip). `joints/world_anchor` is a disabled fixed joint to the world; `base/link6_mount_frame` is the frame to fix to the robot link6."
    kind = "component"
)
