                )
                {
                    float drive:angular:physics:targetPosition = 0
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }
            }

            over "arm_right"
            {
                over "xeg32_base_link" (
                    active = false
                )
                {
                }

                over "xeg32_left_carriage_link" (
                    active = false
                )
                {
                }

                over "xeg32_right_carriage_link" (
                    active = false
                )
                {
                }

                over "xeg32_camera_mount_link" (
                    active = false
                )
                {
                }

                def Xform "right_gripper_tool" (
                    delete apiSchemas = ["PhysicsArticulationRootAPI"]
                    prepend references = @./right_gripper_tool_arm_right.usda@
                )
                {
                    matrix4d xformOp:transform = ( (-0.9999999999730159, -0.00000734641025682567, 0, 0), (0.00000734641025682567, -0.9999999999730159, 0, 0), (0, 0, 1, 0), (-0.0013449814287441186, -9.880785301064066e-9, 0.8699994074013562, 1) )
                    uniform token[] xformOpOrder = ["xformOp:transform"]

                    over "joints"
                    {
                        over "world_anchor" (
                            active = false
                        )
                        {
                        }
                    }
                }
            }
        }
    }

    over "joints"
    {
        def PhysicsFixedJoint "world_fix"
        {
            rel physics:body1 = </D200/base_link>
            point3f physics:localPos0 = (0, 0, 0.0762)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        over "left_wheel_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:targetVelocity = 0
            float physics:lowerLimit = 0
            float physics:upperLimit = 0
        }

        over "right_wheel_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:targetVelocity = 0
