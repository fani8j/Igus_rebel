#usda 1.0
(
    defaultPrim = "right_gripper_tool"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "right_gripper_tool" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    assetInfo = {
        string name = "right_gripper_tool"
        string version = "2.0.0"
    }
    customData = {
        string generator_version = "2.0.0"
        string source = "cad/medical_box_tooling_v1/gripper_tool (urdf/right_gripper_tool.urdf.xacro, meshes/)"
    }
    doc = "Right-arm gripper (SMC LEHF20K2-48 + printed fingers) in the ReBeL link6 frame (metres, +Z out of the flange). Articulation: base + two prismatic fingers along X (0 = closed, pad gap 8 mm; 0.024 = open, pad gap 56 mm). Authored at OPEN."
    kind = "component"
)
{
    def Scope "Looks"
    {
        def Material "printed"
        {
            token outputs:surface.connect = </right_gripper_tool/Looks/printed/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.93, 0.55, 0.12)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "stop"
        {
            token outputs:surface.connect = </right_gripper_tool/Looks/stop/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.2, 0.2)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "finger"
        {
            token outputs:surface.connect = </right_gripper_tool/Looks/finger/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.55, 0.85)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "pad"
        {
            token outputs:surface.connect = </right_gripper_tool/Looks/pad/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.1, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "body"
        {
            token outputs:surface.connect = </right_gripper_tool/Looks/body/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.75, 0.78)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "jaw"
        {
            token outputs:surface.connect = </right_gripper_tool/Looks/jaw/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.62, 0.66)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "pad_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }

        def Material "hard_physics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0
            float physics:staticFriction = 0.4
        }
    }

    def Xform "base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0.0032639792, -0.00004406271, 0.101767145)
        float3 physics:diagonalInertia = (0.0005952995, 0.0009869804, 0.0013566044)
        float physics:mass = 0.84366316
