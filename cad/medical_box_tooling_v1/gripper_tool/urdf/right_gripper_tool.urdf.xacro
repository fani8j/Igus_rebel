<?xml version="1.0"?>
<!-- Right-arm gripper tool: SMC LEHF20K2-48 in-line on the ReBeL flange + custom fingers.  GENERATED by build.py - edit params.py / parts.py instead.
     Macro right_gripper_tool(prefix, parent): fixed base link at identity to `parent` (= link6), 2 prismatic finger joints (0..0.024 m each, mimic), gripper_tcp, top_stop_frame.
     Mesh path convention: ${mesh_root}/meshes/{visual,collision}/*.stl, default mesh_root = package://right_gripper_tool (the folder is not a ROS package: pass mesh_root:=file:///abs/path/to/gripper_tool
     or install it under a package of that name).  Meshes are in metres; base_* are expressed in link6, finger_* in the finger joint frame (origin (0,0,z_J), axes parallel to link6).
     Masses are estimates (printed parts: 1.6 mm shell + 25 %% infill; gripper 0.75 kg catalog).  Finger effort 28 N = LEHF20 max gripping force per finger. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="right_gripper_tool" params="prefix parent mesh_root:=package://right_gripper_tool">
    <material name="${prefix}metal_mat"><color rgba="0.93 0.55 0.12 1"/></material>
    <material name="${prefix}finger_mat"><color rgba="0.15 0.55 0.85 1"/></material>
    <material name="${prefix}pad_mat"><color rgba="0.1 0.1 0.1 1"/></material>
    <material name="${prefix}jaw_mat"><color rgba="0.6 0.62 0.66 1"/></material>
    <link name="${prefix}gripper_base">
    <inertial>
      <origin xyz="0.0032639792 -4.40627069e-05 0.101767145" rpy="0 0 0"/>
      <mass value="0.843663131"/>
      <inertia ixx="0.000596004635" ixy="1.4395939e-07" ixz="-1.66030691e-05" iyy="0.00135660383" iyz="4.31842193e-07" izz="0.000986275763"/>
    </inertial>
    <visual>
      <geometry><mesh filename="${mesh_root}/meshes/visual/base_flange_disc.stl"/></geometry>
      <material name="${prefix}metal_mat"/>
    </visual>
    <visual>
      <geometry><mesh filename="${mesh_root}/meshes/visual/base_gripper_plate.stl"/></geometry>
      <material name="${prefix}metal_mat"/>
    </visual>
    <visual>
      <geometry><mesh filename="${mesh_root}/meshes/visual/base_top_stop.stl"/></geometry>
      <material name="${prefix}metal_mat"/>
    </visual>
    <visual>
      <geometry><mesh filename="${mesh_root}/meshes/visual/base_smc_body.stl"/></geometry>
      <material name="${prefix}jaw_mat"/>
    </visual>
    <collision>
      <geometry><mesh filename="${mesh_root}/meshes/collision/base_flange_disc.stl"/></geometry>
    </collision>
    <collision>
      <geometry><mesh filename="${mesh_root}/meshes/collision/base_gripper_plate.stl"/></geometry>
    </collision>
    <collision>
      <geometry><mesh filename="${mesh_root}/meshes/collision/base_top_stop_bar.stl"/></geometry>
    </collision>
    <collision>
      <geometry><mesh filename="${mesh_root}/meshes/collision/base_top_stop_neg.stl"/></geometry>
    </collision>
    <collision>
      <geometry><mesh filename="${mesh_root}/meshes/collision/base_top_stop_pos.stl"/></geometry>
    </collision>
    <collision>
      <geometry><mesh filename="${mesh_root}/meshes/collision/base_smc_body_0.stl"/></geometry>
    </collision>
    <collision>
      <geometry><mesh filename="${mesh_root}/meshes/collision/base_smc_body_1.stl"/></geometry>
    </collision>
    <collision>
      <geometry><mesh filename="${mesh_root}/meshes/collision/base_smc_body_2.stl"/></geometry>
    </collision>
    </link>
    <joint name="${prefix}gripper_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}gripper_base"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}finger_left">
    <inertial>
      <origin xyz="-0.0108579301 0.000383410374 0.028755911" rpy="0 0 0"/>
      <mass value="0.0525123601"/>
      <inertia ixx="4.49993951e-05" ixy="-3.09977777e-07" ixz="-2.23904624e-07" iyy="3.83483804e-05" iyz="7.54110674e-07" izz="1.34577024e-05"/>
    </inertial>
    <visual>
      <geometry><mesh filename="${mesh_root}/meshes/visual/finger_left.stl"/></geometry>
      <material name="${prefix}finger_mat"/>
    </visual>
    <visual>
      <geometry><mesh filename="${mesh_root}/meshes/visual/finger_pad_left.stl"/></geometry>
      <material name="${prefix}pad_mat"/>
    </visual>
    <visual>
      <geometry><mesh filename="${mesh_root}/meshes/visual/finger_jaw_left.stl"/></geometry>
      <material name="${prefix}jaw_mat"/>
    </visual>
    <collision>
      <geometry><mesh filename="${mesh_root}/meshes/collision/finger_left_foot.stl"/></geometry>
    </collision>
    <collision>
      <geometry><mesh filename="${mesh_root}/meshes/collision/finger_left_column.stl"/></geometry>
    </collision>
    <collision>
      <geometry><mesh filename="${mesh_root}/meshes/collision/finger_left_block.stl"/></geometry>
    </collision>
    <collision>
      <geometry><mesh filename="${mesh_root}/meshes/collision/finger_pad_left.stl"/></geometry>
    </collision>
    <collision>
      <geometry><mesh filename="${mesh_root}/meshes/collision/finger_jaw_left_top.stl"/></geometry>
    </collision>
    <collision>
      <geometry><mesh filename="${mesh_root}/meshes/collision/finger_jaw_left_low.stl"/></geometry>
    </collision>
    </link>
    <joint name="${prefix}finger_left_joint" type="prismatic">
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}finger_left"/>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <axis xyz="-1 0 0"/>
      <limit lower="0" upper="0.024" effort="28" velocity="0.05"/>
    </joint>
    <link name="${prefix}finger_right">
    <inertial>
      <origin xyz="0.0108579301 -0.000383410374 0.028755911" rpy="0 0 0"/>
      <mass value="0.0525123601"/>
      <inertia ixx="4.49993951e-05" ixy="-3.09977777e-07" ixz="2.23904624e-07" iyy="3.83483804e-05" iyz="-7.54110674e-07" izz="1.34577024e-05"/>
    </inertial>
    <visual>
      <geometry><mesh filename="${mesh_root}/meshes/visual/finger_right.stl"/></geometry>
      <material name="${prefix}finger_mat"/>
    </visual>
    <visual>
      <geometry><mesh filename="${mesh_root}/meshes/visual/finger_pad_right.stl"/></geometry>
      <material name="${prefix}pad_mat"/>
    </visual>
    <visual>
      <geometry><mesh filename="${mesh_root}/meshes/visual/finger_jaw_right.stl"/></geometry>
      <material name="${prefix}jaw_mat"/>
    </visual>
    <collision>
      <geometry><mesh filename="${mesh_root}/meshes/collision/finger_right_foot.stl"/></geometry>
    </collision>
    <collision>
      <geometry><mesh filename="${mesh_root}/meshes/collision/finger_right_column.stl"/></geometry>
    </collision>
    <collision>
      <geometry><mesh filename="${mesh_root}/meshes/collision/finger_right_block.stl"/></geometry>
    </collision>
    <collision>
      <geometry><mesh filename="${mesh_root}/meshes/collision/finger_pad_right.stl"/></geometry>
    </collision>
    <collision>
      <geometry><mesh filename="${mesh_root}/meshes/collision/finger_jaw_right_top.stl"/></geometry>
    </collision>
    <collision>
      <geometry><mesh filename="${mesh_root}/meshes/collision/finger_jaw_right_low.stl"/></geometry>
    </collision>
    </link>
    <joint name="${prefix}finger_right_joint" type="prismatic">
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}finger_right"/>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="0" upper="0.024" effort="28" velocity="0.05"/>
      <mimic joint="${prefix}finger_left_joint" multiplier="1" offset="0"/>
    </joint>
    <!-- gripper_tcp: midpoint between the pad centres (z = approach, x = stroke axis) -->
    <link name="${prefix}gripper_tcp"/>
    <joint name="${prefix}gripper_tcp_joint" type="fixed">
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}gripper_tcp"/>
      <origin xyz="0 0 0.1932" rpy="0 0 0"/>
    </joint>
    <!-- top_stop_frame: centre of the fixed top-stop face (box top edge registration plane, z = 0.1675 m); fixed to the base, does not move with the jaws -->
    <link name="${prefix}top_stop_frame"/>
    <joint name="${prefix}top_stop_frame_joint" type="fixed">
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}top_stop_frame"/>
      <origin xyz="0 0 0.1675" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
