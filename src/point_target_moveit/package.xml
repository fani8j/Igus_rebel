<?xml version="1.0"?>
<package format="3">
  <name>point_target_moveit</name>
  <version>0.1.0</version>
  <description>
    ROS 2 node that receives a PointStamped target, transforms it to the robot
    planning frame using TF2, creates a TCP pose, and plans to it with MoveIt 2.
  </description>

  <maintainer email="farhan@example.com">farhan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>moveit_ros_planning_interface</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
