<?xml version="1.0" encoding="UTF-8" ?>
<!-- Test-only FastDDS profile: shared-memory transport only (no network sockets at all).
     Why: ROS_LOCALHOST_ONLY=1 makes Humble's rmw_fastrtps use loopback UDP only, which drops most 4-6 MB image
     messages (net.core.rmem_max = 208 KB). SHM delivers them all and cannot leave the machine. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_only</transport_id>
      <type>SHM</type>
      <segment_size>268435456</segment_size>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="shm_only_participant" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports><transport_id>shm_only</transport_id></userTransports>
    </rtps>
  </participant>
</profiles>
