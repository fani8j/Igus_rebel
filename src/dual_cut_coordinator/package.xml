<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dual_cut_coordinator</name>
  <version>0.1.0</version>
  <description>
    Coordinator for two per-arm box_h_cut_executor instances on the dual ReBeL cell: pure
    trajectory / swept-volume / phase logic as a tested library (WP5); the ROS node is a stub
    until WP6. See scan_results/dual_arm_stack_20261014/design/P3_P4_DESIGN.md.
  </description>
  <maintainer email="farhan@example.com">Farhan</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>dual_cut_msgs</depend>
  <depend>eigen</depend>
  <depend>geometric_shapes</depend>
  <depend>moveit_core</depend>
  <depend>control_msgs</depend>
  <depend>controller_manager_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>shape_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_index_cpp</test_depend>
  <test_depend>joint_trajectory_controller</test_depend>
  <test_depend>srdfdom</test_depend>
  <test_depend>urdf</test_depend>
  <!-- the one optional test that loads the real dual model (skipped when not installed) -->
  <test_depend>rebel_dual_table_description</test_depend>
  <test_depend>rebel_dual_table_moveit_config</test_depend>
  <test_depend>xacro</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
