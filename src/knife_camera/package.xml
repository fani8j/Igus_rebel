<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>knife_camera</name>
  <version>0.0.0</version>
  <description>Logitech C930e knife-view camera: usb_cam launch with a fixed manual focus.</description>
  <maintainer email="hucenrotiacompal@gmail.com">fani8j</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>usb_cam</exec_depend>
  <exec_depend>image_transport_plugins</exec_depend>
  <!-- v4l2-ctl: sets focus with the control names of the running kernel. -->
  <exec_depend>v4l-utils</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
