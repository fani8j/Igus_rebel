<?xml version="1.0"?>
<!-- Our cell tooling for ONE arm: SMC LEHF20K2-48 gripper, fingers, knife clamp / post / handpiece / blade, Gemini 305 wrist camera + bracket,
     USB knife camera + bracket, and the TCP frame ${prefix}knife_tip.  Written new for this package (not derived from compal_robot); the geometry
     conventions come from tools/cell_planner_check/gen_cell.py + gen_cell_v3.py.

     ALL numbers live in the YAML named by the xacro arg `tool_config` (default config/cell_tool_v3_r_1269.yaml, generated by
     scripts/make_tool_config.py from tools/cell_planner_check/designs/v3_r_1269_A0_B0.json = cell_v3_20261004/recommended.json rank 1).
     This file contains no geometry numbers: it instantiates, for every entry of the YAML list `links`, one fixed-joint link named
     ${prefix}<name> carrying the listed visual / collision primitives (mesh | box | cylinder | sphere, origin as xyz / rpy strings).  A later tooling revision
     (v4, ultrasonic cutter, cad/dual_arm_tooling_v2) therefore only needs a new YAML (+ meshes) and `tool_config:=<file>`; the only names other
     parts of the package rely on are ${prefix}knife_tip (the TCP, tcp_link in the YAML), ${prefix}wrist_camera_link / _optical_frame and
     ${prefix}knife_camera_link / _optical_frame.

     Frames, per arm (all rigid on link6):
       ${prefix}tool_flange                 link6 + 52.7 mm Z (gripper mounting face), link6 orientation
       ${prefix}gripper                     SMC mesh (already in the link6 frame)
       ${prefix}fingers                     visual: convex hulls of the real fingers (grasp state); collision: boxes, union of grasp+open states
       ${prefix}knife_post / _clamp / _handpiece   cylinder / sphere / capsule; _blade visual only (collision false: last 20 mm exempt)
       ${prefix}wrist_camera_link           Gemini 305 body, ROS body frame (x forward) at the lens face; _optical_frame = REP-103 optical (z forward)
       ${prefix}wrist_camera_bracket        bracket cylinder
       ${prefix}knife_camera_link / _optical_frame / _bracket   USB camera B on the knife clamp
       ${prefix}knife_tip                   TCP = T_link6_tcp of the design; NO collision geometry (green marker sphere visual only)
     The tooling is the same on both arms (not mirrored), as in cell_planner_check. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="tool_config" default="cell_tool_v3_r_1269.yaml" />
  <xacro:property name="_tool_cfg_arg" value="$(arg tool_config)" />
  <xacro:property name="_tool_cfg_dir" value="$(find rebel_dual_arm_stand_description)/config" />
  <xacro:property name="_tool_cfg_path"
                  value="${_tool_cfg_arg if _tool_cfg_arg.startswith('/') else _tool_cfg_dir + '/' + _tool_cfg_arg}" />
  <xacro:property name="_tool" value="${xacro.load_yaml(_tool_cfg_path)}" />

  <!-- one geometry primitive: origin + geometry elements -->
  <xacro:macro name="_tool_geometry" params="p">
    <origin xyz="${p['xyz']}" rpy="${p['rpy']}" />
    <geometry>
      <xacro:if value="${p['type'] == 'mesh'}"><mesh filename="${p['file']}" /></xacro:if>
      <xacro:if value="${p['type'] == 'box'}"><box size="${p['size']}" /></xacro:if>
      <xacro:if value="${p['type'] == 'cylinder'}"><cylinder radius="${p['radius']}" length="${p['length']}" /></xacro:if>
      <xacro:if value="${p['type'] == 'sphere'}"><sphere radius="${p['radius']}" /></xacro:if>
    </geometry>
  </xacro:macro>

  <!-- recursion over the primitive lists (xacro has no loops). The material is defined (with its colour) on the first visual of a link only,
       later visuals of the same link refer to it by name; material names are unique per arm and link. -->
  <xacro:macro name="_tool_visuals" params="prims mat rgba i:=0">
    <xacro:if value="${i &lt; len(prims)}">
      <visual>
        <xacro:_tool_geometry p="${prims[i]}" />
        <xacro:if value="${i == 0}"><material name="${mat}"><color rgba="${rgba}" /></material></xacro:if>
        <xacro:if value="${i != 0}"><material name="${mat}" /></xacro:if>
      </visual>
      <xacro:_tool_visuals prims="${prims}" mat="${mat}" rgba="${rgba}" i="${i + 1}" />
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="_tool_collisions" params="prims i:=0">
    <xacro:if value="${i &lt; len(prims)}">
      <collision>
        <xacro:_tool_geometry p="${prims[i]}" />
      </collision>
      <xacro:_tool_collisions prims="${prims}" i="${i + 1}" />
    </xacro:if>
  </xacro:macro>

  <!-- recursion over the link list -->
  <xacro:macro name="_tool_links" params="prefix parent links i:=0">
    <xacro:if value="${i &lt; len(links)}">
      <link name="${prefix}${links[i]['name']}">
        <xacro:_tool_visuals prims="${links[i]['visual']}" mat="${prefix}${links[i]['name']}_mat" rgba="${links[i]['rgba']}" />
        <xacro:_tool_collisions prims="${links[i]['collision']}" />
      </link>
      <joint name="${prefix}${links[i]['name']}_joint" type="fixed">
        <origin xyz="${links[i]['joint_xyz']}" rpy="${links[i]['joint_rpy']}" />
        <parent link="${parent if links[i]['parent'] == 'link6' else prefix + links[i]['parent']}" />
        <child link="${prefix}${links[i]['name']}" />
      </joint>
      <xacro:_tool_links prefix="${prefix}" parent="${parent}" links="${links}" i="${i + 1}" />
    </xacro:if>
  </xacro:macro>

  <!-- prefix: e.g. arm_left_ ; parent: the arm's link6, e.g. arm_left_link6 -->
  <xacro:macro name="rebel_cell_tool" params="prefix parent">
    <xacro:_tool_links prefix="${prefix}" parent="${parent}" links="${_tool['links']}" />
  </xacro:macro>

</robot>
