<?xml version="1.0"?>
<!-- Derived from compal_robot (MIT, (c) 2026 James) src/igus_rebel_description/urdf/igus_rebel2_arm_macro.xacro @ bb76327;
     see ../NOTICE. Kinematics, masses, collision primitives and joint limits are made to match OUR single-arm
     src/igus_rebel_description/urdf/igus_rebel2.urdf (joint limits are the controller limits minus 1 deg, velocity
     0.785 rad/s); test/check_arm_fk.py verifies this numerically. Differences to compal_robot's macro: joint limits
     (their: +-179 deg j1/j4/j6, j2 -80..140, j3 -80..140, j5 +-95; ours: +-178, -79..139, -79..139, +-94), velocity
     0.785 instead of 0.785398, and macro name / parameters (no joint2_lower/joint3_upper/arm_velocity overrides).
     Link/joint names after the prefix are unchanged from both sources. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="rebel_arm_chain"
               params="prefix parent_link xyz rpy">

    <joint name="${prefix}mount" type="fixed">
