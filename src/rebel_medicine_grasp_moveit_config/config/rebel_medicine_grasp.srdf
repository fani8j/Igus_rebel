<?xml version='1.0' encoding='utf-8'?>
<robot name="rebel_medicine_grasp">
  <!-- MoveIt - medicine grasp. Generated by scripts/make_srdf.py (group structure and the rig Adjacent pairs follow rebel_dual_arm_stand_moveit_config, i.e. compal_robot dual_arm_rig.srdf @ bb76327, MIT, see NOTICE). Collision matrix is conservative: Adjacent/rigid pairs and our single-arm SRDF pairs only, no sampled "Never" pairs. -->
  <group name="gantry">
    <joint name="lift_joint" />
    <joint name="slider_left_joint" />
    <joint name="slider_right_joint" />
  </group>
  <group name="arm_left">
    <chain base_link="arm_left_base_link" tip_link="arm_left_suction_tcp" />
  </group>
  <group name="arm_right">
    <chain base_link="arm_right_base_link" tip_link="arm_right_gripper_tcp" />
  </group>
  <group name="dual_arm">
    <group name="gantry" />
    <group name="arm_left" />
    <group name="arm_right" />
  </group>
  <group name="right_gripper">
    <joint name="arm_right_finger_left_joint" />
  </group>
  <group name="left_suction_tool">
    <link name="arm_left_suction_tool" />
  </group>
  <end_effector name="left_suction" parent_link="arm_left_link6" group="left_suction_tool" parent_group="arm_left" />
  <end_effector name="right_gripper_ee" parent_link="arm_right_link6" group="right_gripper" parent_group="arm_right" />
  <group_state name="home" group="gantry">
    <joint name="lift_joint" value="-0.2" />
    <joint name="slider_left_joint" value="-0.005973" />
    <joint name="slider_right_joint" value="0.005973" />
  </group_state>
  <group_state name="home" group="arm_left">
    <joint name="arm_left_joint1" value="0.0" />
    <joint name="arm_left_joint2" value="0.0" />
    <joint name="arm_left_joint3" value="0.0" />
    <joint name="arm_left_joint4" value="0.0" />
    <joint name="arm_left_joint5" value="0.0" />
    <joint name="arm_left_joint6" value="0.0" />
  </group_state>
  <group_state name="home" group="arm_right">
    <joint name="arm_right_joint1" value="0.0" />
    <joint name="arm_right_joint2" value="0.0" />
    <joint name="arm_right_joint3" value="0.0" />
    <joint name="arm_right_joint4" value="0.0" />
    <joint name="arm_right_joint5" value="0.0" />
    <joint name="arm_right_joint6" value="0.0" />
  </group_state>
  <group_state name="home" group="dual_arm">
    <joint name="lift_joint" value="-0.2" />
    <joint name="slider_left_joint" value="-0.005973" />
    <joint name="slider_right_joint" value="0.005973" />
    <joint name="arm_left_joint1" value="0.0" />
    <joint name="arm_left_joint2" value="0.0" />
    <joint name="arm_left_joint3" value="0.0" />
    <joint name="arm_left_joint4" value="0.0" />
    <joint name="arm_left_joint5" value="0.0" />
    <joint name="arm_left_joint6" value="0.0" />
    <joint name="arm_right_joint1" value="0.0" />
    <joint name="arm_right_joint2" value="0.0" />
    <joint name="arm_right_joint3" value="0.0" />
    <joint name="arm_right_joint4" value="0.0" />
    <joint name="arm_right_joint5" value="0.0" />
    <joint name="arm_right_joint6" value="0.0" />
  </group_state>
  <group_state name="gripper_open" group="right_gripper">
    <joint name="arm_right_finger_left_joint" value="0.024" />
  </group_state>
  <group_state name="gripper_closed" group="right_gripper">
    <joint name="arm_right_finger_left_joint" value="0.0" />
  </group_state>
  <disable_collisions link1="arm_left_base_link" link2="arm_left_link1" reason="Never" />
