<robot name="rebel_dual_arm">
  <!-- Generated by scripts/make_srdf.py (group structure and the rig Adjacent pairs follow compal_robot dual_arm_rig.srdf @ bb76327, MIT, see NOTICE). Collision matrix is conservative: Adjacent/rigid pairs and our single-arm SRDF pairs only, no sampled "Never" pairs. -->
