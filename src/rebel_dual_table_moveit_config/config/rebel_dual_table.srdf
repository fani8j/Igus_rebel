<robot name="rebel_dual_table">
    <!-- The URDF root is the fixed "world" link, so no virtual joint is declared. The tool
         joints are fixed, so no passive joints either. The arm groups end at the kinematic TCP
         (<prefix>xeg32_tool_tip), the pose reference for goals and IK. -->
