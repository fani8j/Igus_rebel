<?xml version='1.0' encoding='utf-8'?>
<robot name="igus_rebel_with_xeg32">
    <group name="igus_rebel_arm">
        <link name="world" />
        <link name="base_link" />
        <link name="link1" />
        <link name="motor1" />
        <link name="link2" />
        <link name="motor2" />
        <link name="link3" />
        <link name="motor3" />
        <link name="link4" />
        <link name="motor4" />
        <link name="link5" />
        <link name="motor5" />
        <link name="link6" />
        <joint name="joint1" />
        <joint name="J_motor1" />
        <joint name="joint2" />
        <joint name="J_motor2" />
        <joint name="joint3" />
        <joint name="J_motor3" />
        <joint name="joint4" />
        <joint name="J_motor4" />
        <joint name="joint5" />
        <joint name="J_motor5" />
        <joint name="joint6" />
        <chain base_link="world" tip_link="link6" />
    </group>
    <group name="xeg32_gripper">
        <link name="xeg32_base_link" />
        <link name="xeg32_left_carriage_link" />
        <link name="xeg32_right_carriage_link" />
        <joint name="xeg32_left_carriage_joint" />
    </group>
    <group_state name="home" group="igus_rebel_arm">
        <joint name="joint1" value="0" />
        <joint name="joint2" value="0" />
        <joint name="joint3" value="0" />
        <joint name="joint4" value="0" />
        <joint name="joint5" value="0" />
        <joint name="joint6" value="0" />
    </group_state>
    <group_state name="zeros" group="igus_rebel_arm">
        <joint name="joint1" value="0" />
        <joint name="joint2" value="0" />
        <joint name="joint3" value="0" />
        <joint name="joint4" value="0" />
        <joint name="joint5" value="0" />
        <joint name="joint6" value="0" />
    </group_state>
    <passive_joint name="xeg32_right_carriage_joint" />
    <passive_joint name="xeg32_camera_tilt_joint" />
    <end_effector name="xeg32" parent_link="link6" group="xeg32_gripper" parent_group="igus_rebel_arm" />
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link" />
    <disable_collisions link1="base_link" link2="motor1" reason="Adjacent" />
    <disable_collisions link1="motor1" link2="link1" reason="Adjacent" />
    <disable_collisions link1="motor2" link2="link1" reason="Adjacent" />
    <disable_collisions link1="link1" link2="link2" reason="Adjacent" />
    <disable_collisions link1="motor2" link2="link2" reason="Adjacent" />
    <disable_collisions link1="motor3" link2="link2" reason="Adjacent" />
    <disable_collisions link1="link2" link2="link3" reason="Adjacent" />
    <disable_collisions link1="motor3" link2="link3" reason="Adjacent" />
    <disable_collisions link1="motor4" link2="link3" reason="Adjacent" />
    <disable_collisions link1="motor4" link2="link4" reason="Adjacent" />
    <disable_collisions link1="motor5" link2="link4" reason="Adjacent" />
    <disable_collisions link1="link4" link2="link5" reason="Adjacent" />
    <disable_collisions link1="link4" link2="link6" reason="Adjacent" />
    <disable_collisions link1="motor5" link2="link5" reason="Adjacent" />
    <disable_collisions link1="link5" link2="link6" reason="Adjacent" />
    <disable_collisions link1="link6" link2="xeg32_base_link" reason="Adjacent" />
    <disable_collisions link1="xeg32_base_link" link2="xeg32_left_carriage_link" reason="Adjacent" />
    <disable_collisions link1="xeg32_base_link" link2="xeg32_right_carriage_link" reason="Adjacent" />
    <disable_collisions link1="xeg32_base_link" link2="xeg32_camera_mount_link" reason="Adjacent" />
    <disable_collisions link1="xeg32_base_link" link2="xeg32_cutter_link" reason="Adjacent" />
    <disable_collisions link1="xeg32_cutter_link" link2="xeg32_left_carriage_link" reason="Adjacent" />
    <disable_collisions link1="xeg32_cutter_link" link2="xeg32_right_carriage_link" reason="Adjacent" />
    <disable_collisions link1="link6" link2="xeg32_cutter_link" reason="Adjacent" />
</robot>