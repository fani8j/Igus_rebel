<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rebel_mocap_follower</name>
  <version>0.1.0</version>
  <description>Safety-gated motion-capture joint follower for the igus ReBeL arm via MoveIt Servo JointJog.</description>
  <maintainer email="farhan@example.com">Farhan</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>moveit_servo</exec_depend>
  <exec_depend>rebel_servo_relay</exec_depend>
  <exec_depend>igus_rebel_moveit_config</exec_depend>
  <exec_depend>igus_rebel_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <!-- dual-arm mode only (mocap_follower_dual.launch.py): -->
  <exec_depend>dual_teleop</exec_depend>
  <exec_depend>dual_cut_msgs</exec_depend>
  <exec_depend>rebel_dual_table_description</exec_depend>
  <exec_depend>rebel_dual_table_moveit_config</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
