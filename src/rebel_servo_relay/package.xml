<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rebel_servo_relay</name>
  <version>0.1.0</version>
  <description>Pass-through MoveIt Servo smoothing plugin and a relay that re-anchors Servo's joint trajectories on its own reference, so Servo teleop moves the ReBeL arms at the commanded speed.</description>
  <maintainer email="farhan@example.com">Farhan</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>pluginlib</depend>
  <depend>moveit_core</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>urdf</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
