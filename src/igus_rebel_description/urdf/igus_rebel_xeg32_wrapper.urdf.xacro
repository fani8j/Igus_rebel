<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="igus_rebel_with_xeg32">

  <!-- Keep the ReBeL arm hardware configuration independent from the gripper. -->
  <xacro:arg name="hardware_protocol" default="rebel"/>
  <!-- CRI controller address: 192.168.3.11 = wired LAN (default), 192.168.50.133 = Wi-Fi. -->
  <xacro:arg name="robot_ip" default="192.168.3.11"/>
  <xacro:arg name="include_ros2_control" default="true"/>
  <xacro:arg name="attach_xeg32" default="true"/>

  <!-- Retained rough gripper mount; not used to define the calibrated TCP. -->
  <xacro:arg name="xeg32_mount_xyz" default="0 0 0.052"/>
  <xacro:arg name="xeg32_mount_rpy" default="0 0 0.261799"/>

  <xacro:include filename="$(find igus_rebel_description)/urdf/igus_rebel2.urdf"/>
  <xacro:include filename="$(find igus_rebel_description)/urdf/igus_rebel2.control.xacro"/>
  <xacro:include filename="$(find igus_rebel_description)/urdf/xeg32_gripper.urdf.xacro"/>

  <xacro:if value="$(arg include_ros2_control)">
    <xacro:igus_rebel_control
      arm_id="rebel_arm"
      hardware_protocol="$(arg hardware_protocol)"
      robot_ip="$(arg robot_ip)"/>
  </xacro:if>

  <!-- Same world attachment used by igus_rebel_robot2.urdf.xacro. -->
  <link name="world"/>
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:if value="$(arg attach_xeg32)">
    <xacro:xeg32_gripper
      parent_link="link6"
      prefix="xeg32_"
      flange_xyz="$(arg xeg32_mount_xyz)"
      flange_rpy="$(arg xeg32_mount_rpy)"/>
  </xacro:if>
  <!-- Calibrated frames remain available even when gripper visuals are omitted. -->
  <link name="igus_tool0"/>
  <joint name="link6_to_igus_tool0" type="fixed">
    <parent link="link6"/>
    <child link="igus_tool0"/>
    <origin xyz="0 0 0.0527" rpy="0 0 3.141592653589793"/>
  </joint>
  <link name="xeg32_tool_tip">
    <visual>
      <geometry><sphere radius="0.006"/></geometry>
      <material name="xeg32_tool_tip_marker"><color rgba="0.1 1 0.1 1"/></material>
    </visual>
  </link>
  <!-- touch-corrected 2026-09-24c: XY-only safety fix (tip -0.7/+4.6mm tool from CENTER residual); Z held at +15mm fix (0.130699) pending stale-model check -->
  <joint name="igus_tool0_to_xeg32_tool_tip" type="fixed">
    <parent link="igus_tool0"/>
    <child link="xeg32_tool_tip"/>
    <origin xyz="0.005937 0.094121 0.130699" rpy="0 0 0"/>
  </joint>

  <!-- Tooling mounted on the XEG-32 gripper (2026-09-28): the ultrasonic knife
       handpiece + holder and the wrist camera + bracket. Collision-only
       conservative hulls, registered from operator-confirmed measurements and
       the JK-Final version.step CAD (handpiece, holder) or estimated from
       photos scaled against the gripper (wrist camera); see
       XEG32_MOVEIT_CHANGES.md and HANDOFF.md for the placement reasoning.
       xeg32_tool_tip itself (the TCP, the exposed ~20 mm of blade below it)
       intentionally carries no collision geometry. All origins here are
       identity: the meshes are already expressed in igus_tool0 coordinates. -->
  <xacro:if value="$(arg attach_xeg32)">
    <link name="xeg32_knife_handpiece">
      <visual>
        <geometry><mesh filename="package://igus_rebel_description/meshes/xeg32_collision/knife_handpiece.stl"/></geometry>
        <material name="xeg32_knife_handpiece_material"><color rgba="0.2 0.2 0.2 0.6"/></material>
      </visual>
      <collision>
        <geometry><mesh filename="package://igus_rebel_description/meshes/xeg32_collision/knife_handpiece.stl"/></geometry>
      </collision>
    </link>
    <joint name="igus_tool0_to_xeg32_knife_handpiece" type="fixed">
      <parent link="igus_tool0"/>
      <child link="xeg32_knife_handpiece"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="xeg32_knife_holder">
      <visual>
        <geometry><mesh filename="package://igus_rebel_description/meshes/xeg32_collision/knife_holder_ring.stl"/></geometry>
        <material name="xeg32_knife_holder_material"><color rgba="0.6 0.6 0.6 0.6"/></material>
      </visual>
      <collision>
        <geometry><mesh filename="package://igus_rebel_description/meshes/xeg32_collision/knife_holder_ring.stl"/></geometry>
      </collision>
      <visual>
        <geometry><mesh filename="package://igus_rebel_description/meshes/xeg32_collision/knife_holder_body.stl"/></geometry>
        <material name="xeg32_knife_holder_material"/>
      </visual>
      <collision>
        <geometry><mesh filename="package://igus_rebel_description/meshes/xeg32_collision/knife_holder_body.stl"/></geometry>
      </collision>
    </link>
    <joint name="igus_tool0_to_xeg32_knife_holder" type="fixed">
      <parent link="igus_tool0"/>
      <child link="xeg32_knife_holder"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <!-- Wrist camera removed 2026-09-28: it protruded past the blade tip along the knife
         axis and hit the carton; it is uninstalled until the combined knife/camera holder
         is redesigned. -->
  </xacro:if>
</robot>
