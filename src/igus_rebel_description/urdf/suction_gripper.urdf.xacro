<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Improved visual approximation for:
      ReBeL link6 -> igus REBEL-TCP-0100 -> Schmalz ECBPMi -> SPB1-30 cup

    The visual meshes in meshes/suction_approx were generated in metres from
    official envelope dimensions and product photographs. They are not
    manufacturing CAD and should not be used for machining or interference
    certification. Collision geometry intentionally remains simple.
  -->

  <xacro:macro name="rebel_schmalz_ecbpmi"
               params="parent_link prefix flange_xyz flange_rpy total_tool_mass cup_diameter cup_exposed_height show_cable:=false">

    <!-- igus REBEL-TCP-0100 -->
    <xacro:property name="adapter_radius" value="0.0300"/>
    <xacro:property name="adapter_thickness" value="0.0100"/>
    <xacro:property name="adapter_mass" value="0.0459"/>

    <!-- Schmalz ECBPMi official overall envelope -->
    <xacro:property name="pump_radius" value="0.0315"/>
    <xacro:property name="pump_body_length" value="0.0564"/>
    <xacro:property name="pump_mount_offset" value="0.0110"/>
    <xacro:property name="connector_radius" value="0.01575"/>
    <xacro:property name="connector_length" value="0.0060"/>

    <xacro:property name="pump_mass" value="${total_tool_mass - adapter_mass}"/>
    <xacro:property name="tcp_from_pump" value="${pump_body_length + connector_length + cup_exposed_height}"/>

    <!-- Robot flange -> igus ISO-50 adapter. -->
    <joint name="${prefix}rebel_tcp_adapter_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${prefix}rebel_tcp_adapter_link"/>
      <origin xyz="${flange_xyz}" rpy="${flange_rpy}"/>
    </joint>

    <link name="${prefix}rebel_tcp_adapter_link">
      <inertial>
        <origin xyz="0 0 ${adapter_thickness / 2.0}" rpy="0 0 0"/>
        <mass value="${adapter_mass}"/>
        <inertia
          ixx="${adapter_mass * (3.0 * adapter_radius * adapter_radius + adapter_thickness * adapter_thickness) / 12.0}"
          ixy="0.0" ixz="0.0"
          iyy="${adapter_mass * (3.0 * adapter_radius * adapter_radius + adapter_thickness * adapter_thickness) / 12.0}"
          iyz="0.0"
          izz="${0.5 * adapter_mass * adapter_radius * adapter_radius}"/>
      </inertial>

      <!-- Approximate ring mesh: OD 60 mm, centre opening about 35 mm. -->
      <visual name="rebel_tcp_adapter_visual">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/suction_approx/rebel_tcp_0100_adapter_approx.stl"
                scale="1 1 1"/>
        </geometry>
        <material name="rebel_adapter_black">
          <color rgba="0.045 0.045 0.050 1.0"/>
        </material>
      </visual>

      <!-- Small metallic locating shoulder between adapter and pump. -->
      <visual name="adapter_locating_shoulder_visual">
        <origin xyz="0 0 0.0120" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.0160" length="0.0010"/>
        </geometry>
        <material name="adapter_shoulder_metal">
          <color rgba="0.50 0.52 0.54 1.0"/>
        </material>
      </visual>

      <collision name="rebel_tcp_adapter_collision">
        <origin xyz="0 0 ${adapter_thickness / 2.0}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${adapter_radius}" length="${adapter_thickness}"/>
        </geometry>
      </collision>
    </link>

    <!-- igus adapter -> Schmalz pump. -->
    <joint name="${prefix}schmalz_pump_mount_joint" type="fixed">
      <parent link="${prefix}rebel_tcp_adapter_link"/>
      <child link="${prefix}schmalz_ecbpmi_link"/>
      <origin xyz="0 0 ${pump_mount_offset}" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}schmalz_ecbpmi_link">
      <inertial>
        <origin xyz="0 0 ${pump_body_length / 2.0}" rpy="0 0 0"/>
        <mass value="${pump_mass}"/>
        <inertia
          ixx="${pump_mass * (3.0 * pump_radius * pump_radius + pump_body_length * pump_body_length) / 12.0}"
          ixy="0.0" ixz="0.0"
          iyy="${pump_mass * (3.0 * pump_radius * pump_radius + pump_body_length * pump_body_length) / 12.0}"
          iyz="0.0"
          izz="${0.5 * pump_mass * pump_radius * pump_radius}"/>
      </inertial>

      <!-- Stepped and chamfered pump body approximation. -->
      <visual name="ecbpmi_body_visual">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/suction_approx/schmalz_ecbpmi_body_approx.stl"
                scale="1 1 1"/>
        </geometry>
        <material name="schmalz_housing_black">
          <color rgba="0.035 0.038 0.043 1.0"/>
        </material>
      </visual>

      <!-- Circumferential status ring visible on the real housing. -->
      <visual name="ecbpmi_status_ring_visual">
        <origin xyz="0 0 0.0105" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.0330" length="0.0040"/>
        </geometry>
        <material name="schmalz_status_white">
          <color rgba="0.90 0.91 0.92 1.0"/>
        </material>
      </visual>

      <!-- Orange segmented status/display marking. -->
      <visual name="ecbpmi_orange_arc_visual">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/suction_approx/schmalz_status_arc_approx.stl"
                scale="1 1 1"/>
        </geometry>
        <material name="schmalz_orange">
          <color rgba="1.0 0.43 0.0 1.0"/>
        </material>
      </visual>

      <!-- Approximate Schmalz badge on the front (+X side). -->
      <visual name="schmalz_badge_blue_visual">
        <origin xyz="0.0312 0 0.0240" rpy="0 0 0"/>
        <geometry>
          <box size="0.0016 0.0180 0.0080"/>
        </geometry>
        <material name="schmalz_badge_blue">
          <color rgba="0.00 0.18 0.55 1.0"/>
        </material>
      </visual>
      <visual name="schmalz_badge_white_visual">
        <origin xyz="0.0321 0 0.0240" rpy="0 0 0"/>
        <geometry>
          <box size="0.0008 0.0130 0.0036"/>
        </geometry>
        <material name="schmalz_badge_white">
          <color rgba="0.94 0.95 0.97 1.0"/>
        </material>
      </visual>

      <!-- M8 electrical outlet / elbow approximation on the upper side. -->
      <visual name="ecbpmi_m8_collar_visual">
        <origin xyz="0.0342 0 0.0100" rpy="0 1.57079632679 0"/>
        <geometry>
          <cylinder radius="0.0066" length="0.0060"/>
        </geometry>
        <material name="connector_metal">
          <color rgba="0.46 0.48 0.50 1.0"/>
        </material>
      </visual>
      <visual name="ecbpmi_m8_body_visual">
        <origin xyz="0.0412 0 0.0100" rpy="0 1.57079632679 0"/>
        <geometry>
          <cylinder radius="0.0052" length="0.0080"/>
        </geometry>
        <material name="connector_black">
          <color rgba="0.025 0.025 0.028 1.0"/>
        </material>
      </visual>

      <!-- Optional short service loop; visual only, not the full cable length. -->
      <xacro:if value="${show_cable}">
        <visual name="ecbpmi_cable_loop_visual">
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="package://igus_rebel_description/meshes/suction_approx/schmalz_cable_loop_approx.stl"
                  scale="1 1 1"/>
          </geometry>
          <material name="cable_black">
            <color rgba="0.018 0.018 0.020 1.0"/>
          </material>
        </visual>
      </xacro:if>

      <!-- G1/4 lower connection stack. -->
      <visual name="ecbpmi_lower_connector_visual">
        <origin xyz="0 0 ${pump_body_length + connector_length / 2.0}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${connector_radius}" length="${connector_length}"/>
        </geometry>
        <material name="schmalz_connector_dark">
          <color rgba="0.13 0.14 0.15 1.0"/>
        </material>
      </visual>
      <visual name="suction_fitting_hex_visual">
        <origin xyz="0 0 ${pump_body_length + 0.0032}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.0098" length="0.0042"/>
        </geometry>
        <material name="fitting_metal">
          <color rgba="0.55 0.57 0.59 1.0"/>
        </material>
      </visual>

      <!-- SPB1-30 bellows cup approximation. -->
      <visual name="suction_cup_visual">
        <origin xyz="0 0 ${pump_body_length + connector_length}" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/suction_approx/schmalz_spb1_30_cup_approx.stl"
                scale="${cup_diameter / 0.0367} ${cup_diameter / 0.0367} ${cup_exposed_height / 0.019}"/>
        </geometry>
        <material name="suction_elastomer_green">
          <color rgba="0.12 0.72 0.35 0.88"/>
        </material>
      </visual>

      <!-- Robust physics collision approximations. -->
      <collision name="ecbpmi_body_collision">
        <origin xyz="0 0 ${pump_body_length / 2.0}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${pump_radius}" length="${pump_body_length}"/>
        </geometry>
      </collision>
      <collision name="ecbpmi_connector_collision">
        <origin xyz="0 0 ${pump_body_length + connector_length / 2.0}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${connector_radius}" length="${connector_length}"/>
        </geometry>
      </collision>
      <collision name="suction_cup_collision">
        <origin xyz="0 0 ${pump_body_length + connector_length + cup_exposed_height / 2.0}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${cup_diameter / 2.0}" length="${cup_exposed_height}"/>
        </geometry>
      </collision>
    </link>

    <!-- Nominal tool contact point. -->
    <link name="${prefix}suction_tcp_link"/>
    <joint name="${prefix}suction_tcp_joint" type="fixed">
      <parent link="${prefix}schmalz_ecbpmi_link"/>
      <child link="${prefix}suction_tcp_link"/>
      <origin xyz="0 0 ${tcp_from_pump}" rpy="0 0 0"/>
    </joint>

    <!-- Isaac Surface Gripper frame: local +X points outward. -->
    <link name="${prefix}suction_surface_gripper_frame"/>
    <joint name="${prefix}suction_surface_gripper_frame_joint" type="fixed">
      <parent link="${prefix}schmalz_ecbpmi_link"/>
      <child link="${prefix}suction_surface_gripper_frame"/>
      <origin xyz="0 0 ${tcp_from_pump}" rpy="0 -1.57079632679 0"/>
    </joint>

  </xacro:macro>
</robot>
