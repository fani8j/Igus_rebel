<?xml version="1.0"?>
<!-- igus_rebel.control.xacro -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="igus_rebel_control" params="arm_id hardware_protocol robot_ip:=192.168.3.11 robot_port:=3920 move_joint_max_velocity_percent:=25 jog_velocity_scale:=1.65 cart_jog_percent_per_mps:=200.0 cart_jog_percent_per_radps:=100.0 cart_jog_max_percent:=10.0 cart_jog_allow_rotation:=false cart_jog_signs:=1,1,1,1,1,1 cart_jog_timeout_s:=0.15 cart_jog_idle_exit_s:=10.0 cart_jog_base_frame:=base_link joint_jog_max_percent:=10.0 joint_jog_timeout_s:=0.15 joint_jog_idle_exit_s:=10.0">
        <xacro:macro name="joint_control" params="joint">
            <joint name="${joint}">
                <xacro:if value="${hardware_protocol == 'gazebo' or hardware_protocol == 'isaac_topic' or hardware_protocol == 'mock_hardware'}">
                    <command_interface name="position" />
                </xacro:if>
                <xacro:if value="${hardware_protocol == 'rebel'}">
                    <command_interface name="velocity" />
                </xacro:if>
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
        </xacro:macro>

        <ros2_control name="${arm_id}_controller" type="system">
            <hardware>
                <xacro:if value="${hardware_protocol == 'mock_hardware'}">
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:if>
                <xacro:if value="${hardware_protocol == 'gazebo'}">
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </xacro:if>
                <xacro:if value="${hardware_protocol == 'isaac_topic'}">
                    <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
                    <param name="joint_commands_topic">/isaac_joint_commands</param>
                    <param name="joint_states_topic">/isaac_joint_states</param>
                    <param name="trigger_joint_command_threshold">0.0001</param>
                </xacro:if>
                <xacro:if value="${hardware_protocol == 'rebel'}">
                    <plugin>Igus/Rebel</plugin>
                    <param name="robot_ip">${robot_ip}</param>
                    <param name="robot_port">${robot_port}</param>
                    <param name="move_joint_max_velocity_percent">${move_joint_max_velocity_percent}</param>
                    <param name="jog_velocity_scale">${jog_velocity_scale}</param>
                    <param name="cart_jog_percent_per_mps">${cart_jog_percent_per_mps}</param>
                    <param name="cart_jog_percent_per_radps">${cart_jog_percent_per_radps}</param>
                    <param name="cart_jog_max_percent">${cart_jog_max_percent}</param>
                    <param name="cart_jog_allow_rotation">${cart_jog_allow_rotation}</param>
                    <param name="cart_jog_signs">${cart_jog_signs}</param>
                    <param name="cart_jog_timeout_s">${cart_jog_timeout_s}</param>
                    <param name="cart_jog_idle_exit_s">${cart_jog_idle_exit_s}</param>
                    <param name="cart_jog_base_frame">${cart_jog_base_frame}</param>
                    <param name="joint_jog_max_percent">${joint_jog_max_percent}</param>
                    <param name="joint_jog_timeout_s">${joint_jog_timeout_s}</param>
                    <param name="joint_jog_idle_exit_s">${joint_jog_idle_exit_s}</param>
                </xacro:if>
            </hardware>
            <xacro:joint_control joint="joint1" />
            <xacro:joint_control joint="joint2" />
            <xacro:joint_control joint="joint3" />
            <xacro:joint_control joint="joint4" />
            <xacro:joint_control joint="joint5" />
            <xacro:joint_control joint="joint6" />
        </ros2_control>
        <xacro:if value="${hardware_protocol == 'gazebo'}">
            <gazebo>
                <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                    <robot_param>robot_description</robot_param>
                    <robot_param_node>robot_state_publisher</robot_param_node>
                    <parameters>$(find igus_rebel_moveit_config)/config/ros_controllers.yaml</parameters>
                    <controller_manager_name>controller_manager</controller_manager_name>
                </plugin>
            </gazebo>
        </xacro:if>
    </xacro:macro>
</robot>