<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Reusable HIWIN XEG-32 gripper + camera-mount macro. Geometry/kinematics are taken from the latest Onshape export. -->
  <xacro:macro name="xeg32_gripper" params="parent_link prefix flange_xyz flange_rpy lock_joints:=true attach_cutter:=true cutter_mount_xyz:='-0.077 0 0.029' cutter_mount_rpy:='0 0 0' cutter_length:=0.1855 cutter_width:=0.025 cutter_tip_length:=0.015">
    <joint name="${prefix}mount_joint" type="fixed">
      <origin xyz="${flange_xyz}" rpy="${flange_rpy}" />
      <parent link="${parent_link}" />
      <child link="${prefix}base_link" />
    </joint>
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="-0.00167857 -0.000372897 0.0289976" rpy="0 0 0" />
        <mass value="0.263982" />
        <inertia ixx="0.000381266" ixy="1.06104e-06" ixz="5.938e-09" iyy="0.000106721" iyz="2.12e-10" izz="0.000442224" />
      </inertial>
      <visual>
        <origin xyz="0.049 -0 0.016" rpy="0 -0 -1.5708" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/part_1.stl" />
        </geometry>
        <material name="${prefix}part_1_material">
          <color rgba="0.615686 0.811765 0.929412 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0.049 -0 0.016" rpy="0 -0 -1.5708" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/part_1.stl" />
        </geometry>
      </collision>
      <visual>
        <origin xyz="0.0065 -0 0.029" rpy="0 -0 -1.5708" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/xeg_base.stl" />
        </geometry>
        <material name="${prefix}xeg_base_material">
          <color rgba="0.74902 0.74902 0.74902 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0.0065 -0 0.029" rpy="0 -0 -1.5708" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/xeg_base.stl" />
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 -1.5708" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/part_1__2.stl" />
        </geometry>
        <material name="${prefix}part_1_2_material">
          <color rgba="0.615686 0.811765 0.929412 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 -1.5708" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/part_1__2.stl" />
        </geometry>
      </collision>
    </link>
    <!-- Plan-only knife: 185.5 mm overall, 25 x 25 mm body, and a 15 mm square-pyramid tip. -->
    <xacro:if value="${attach_cutter}">
      <joint name="${prefix}cutter_mount_joint" type="fixed">
        <origin xyz="${cutter_mount_xyz}" rpy="${cutter_mount_rpy}" />
        <parent link="${prefix}base_link" />
        <child link="${prefix}cutter_link" />
      </joint>
      <link name="${prefix}cutter_link">
        <visual>
          <origin xyz="0 0 ${-cutter_tip_length / 2.0}" rpy="0 0 0" />
          <geometry>
            <box size="${cutter_width} ${cutter_width} ${cutter_length - cutter_tip_length}" />
          </geometry>
          <material name="${prefix}cutter_material">
            <color rgba="0.85 0.15 0.15 1" />
          </material>
        </visual>
        <collision>
          <origin xyz="0 0 ${-cutter_tip_length / 2.0}" rpy="0 0 0" />
          <geometry>
            <box size="${cutter_width} ${cutter_width} ${cutter_length - cutter_tip_length}" />
          </geometry>
        </collision>
        <visual>
          <origin xyz="0 0 ${cutter_length / 2.0 - cutter_tip_length / 2.0}" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://igus_rebel_description/meshes/xeg32/cutter_tip_15mm.stl" />
          </geometry>
          <material name="${prefix}cutter_tip_material">
            <color rgba="0.75 0.78 0.82 1" />
          </material>
        </visual>
        <collision>
          <origin xyz="0 0 ${cutter_length / 2.0 - cutter_tip_length / 2.0}" rpy="0 0 0" />
          <geometry>
            <mesh filename="package://igus_rebel_description/meshes/xeg32/cutter_tip_15mm.stl" />
          </geometry>
        </collision>
      </link>
      <joint name="${prefix}tool_tip_joint" type="fixed">
        <!-- Calibrated against the saved middle_only seam_end target 1788412047_726417920. -->
        <origin xyz="-0.012644 -0.004722 0.082408" rpy="0 0 0" />
        <parent link="${prefix}cutter_link" />
        <child link="${prefix}tool_tip" />
      </joint>
      <!-- Visual-only TCP locator: the physical knife geometry remains unchanged. -->
      <link name="${prefix}tool_tip">
        <visual>
          <geometry><sphere radius="0.006" /></geometry>
          <material name="${prefix}tool_tip_marker"><color rgba="0.1 1 0.1 1" /></material>
        </visual>
      </link>
    </xacro:if>
    <link name="${prefix}left_carriage_link">
      <inertial>
        <origin xyz="-0 -0.00376142 -0.00801771" rpy="0 0 0" />
        <mass value="0.0236002" />
        <inertia ixx="1.41079e-06" ixy="0" ixz="0" iyy="2.03222e-06" iyz="-7.27e-10" izz="7.93624e-07" />
      </inertial>
      <visual>
        <origin xyz="0 0.005 -0.0135" rpy="-3.14159 -0 -0" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/right_carriage.stl" />
        </geometry>
        <material name="${prefix}right_carriage_material">
          <color rgba="0 0 0 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0.005 -0.0135" rpy="-3.14159 -0 -0" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/right_carriage.stl" />
        </geometry>
      </collision>
      <visual>
        <origin xyz="-2.30037e-07 -0.004 -0.00315591" rpy="-1.5708 0 0" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/part_1__3.stl" />
        </geometry>
        <material name="${prefix}part_1_3_material">
          <color rgba="0.647059 0.647059 0.647059 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="-2.30037e-07 -0.004 -0.00315591" rpy="-1.5708 0 0" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/part_1__3.stl" />
        </geometry>
      </collision>
    </link>
    <link name="${prefix}right_carriage_link">
      <inertial>
        <origin xyz="-0 -0.00376142 -0.00801771" rpy="0 0 0" />
        <mass value="0.0236002" />
        <inertia ixx="1.41079e-06" ixy="-0" ixz="-0" iyy="2.03222e-06" iyz="-7.27e-10" izz="7.93624e-07" />
      </inertial>
      <visual>
        <origin xyz="-2.30037e-07 -0.004 -0.00315591" rpy="-1.5708 0 -0" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/part_1__3.stl" />
        </geometry>
        <material name="${prefix}part_1_4_material">
          <color rgba="0.647059 0.647059 0.647059 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="-2.30037e-07 -0.004 -0.00315591" rpy="-1.5708 0 -0" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/part_1__3.stl" />
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0.005 -0.0135" rpy="-3.14159 0 0" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/right_carriage.stl" />
        </geometry>
        <material name="${prefix}right_carriage_2_material">
          <color rgba="0 0 0 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0.005 -0.0135" rpy="-3.14159 0 0" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/right_carriage.stl" />
        </geometry>
      </collision>
    </link>
    <link name="${prefix}camera_mount_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="1e-09" />
        <inertia ixx="1e-09" ixy="0" ixz="0" iyy="1e-09" iyz="0" izz="1e-09" />
      </inertial>
      <visual>
        <origin xyz="-0.0120767 0.0750311 -0.0273242" rpy="1e-12 -1.56937 -1.5708" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/00_mb2502_asm_1_1.stl" />
        </geometry>
        <material name="${prefix}00_mb2502_asm_1_1_material">
          <color rgba="0.917647 0.917647 0.917647 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="-0.0120767 0.0750311 -0.0273242" rpy="1e-12 -1.56937 -1.5708" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/00_mb2502_asm_1_1.stl" />
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0.032 -0.009" rpy="-1.5708 -1.5708 0" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/part_1__4.stl" />
        </geometry>
        <material name="${prefix}part_1_5_material">
          <color rgba="0.647059 0.647059 0.647059 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0.032 -0.009" rpy="-1.5708 -1.5708 0" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/part_1__4.stl" />
        </geometry>
      </collision>
    </link>
    <!-- The ReBeL driver currently publishes arm states only. Lock the
         unactuated XEG joints in the planning model until a gripper controller
         publishes their states; this prevents an incomplete robot state. -->
    <xacro:if value="${lock_joints}">
      <joint name="${prefix}left_carriage_joint" type="fixed">
        <origin xyz="-0.0312 0.0334131 0.029" rpy="-1.5708 -1.5708 0" />
        <parent link="${prefix}base_link" />
        <child link="${prefix}left_carriage_link" />
      </joint>
      <joint name="${prefix}right_carriage_joint" type="fixed">
        <origin xyz="-0.0312 -0.0334131 0.029" rpy="1.5708 1.5708 0" />
        <parent link="${prefix}base_link" />
        <child link="${prefix}right_carriage_link" />
      </joint>
      <joint name="${prefix}camera_tilt_joint" type="fixed">
        <origin xyz="0.071 -0.0092 0.055" rpy="1.5708 -0.149605 -0" />
        <parent link="${prefix}base_link" />
        <child link="${prefix}camera_mount_link" />
      </joint>
    </xacro:if>
    <xacro:unless value="${lock_joints}">
      <joint name="${prefix}left_carriage_joint" type="prismatic">
        <origin xyz="-0.0312 0.0334131 0.029" rpy="-1.5708 -1.5708 0" />
        <parent link="${prefix}base_link" />
        <child link="${prefix}left_carriage_link" />
        <axis xyz="0 0 1" />
        <limit effort="10" velocity="10" lower="-0.0116631" upper="0.00483688" />
      </joint>
      <joint name="${prefix}right_carriage_joint" type="prismatic">
        <origin xyz="-0.0312 -0.0334131 0.029" rpy="1.5708 1.5708 0" />
        <parent link="${prefix}base_link" />
        <child link="${prefix}right_carriage_link" />
        <axis xyz="0 0 1" />
        <limit effort="10" velocity="10" lower="-0.0116631" upper="0.00483688" />
        <mimic joint="${prefix}left_carriage_joint" multiplier="1.0" />
      </joint>
      <joint name="${prefix}camera_tilt_joint" type="revolute">
        <origin xyz="0.071 -0.0092 0.055" rpy="1.5708 -0.149605 -0" />
        <parent link="${prefix}base_link" />
        <child link="${prefix}camera_mount_link" />
        <axis xyz="0 0 1" />
        <limit effort="10" velocity="10" lower="-0.062339" upper="0.373993" />
      </joint>
    </xacro:unless>
  </xacro:macro>
</robot>