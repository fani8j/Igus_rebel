<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Rough HIWIN XEG-32 gripper geometry; independent of TCP calibration. -->
  <xacro:macro name="xeg32_gripper" params="parent_link prefix flange_xyz flange_rpy lock_joints:=true">
    <joint name="${prefix}mount_joint" type="fixed">
      <origin xyz="${flange_xyz}" rpy="${flange_rpy}" />
      <parent link="${parent_link}" />
      <child link="${prefix}base_link" />
    </joint>
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="-0.00167857 -0.000372897 0.0289976" rpy="0 0 0" />
        <mass value="0.263982" />
        <inertia ixx="0.000381266" ixy="1.06104e-06" ixz="5.938e-09" iyy="0.000106721" iyz="2.12e-10" izz="0.000442224" />
      </inertial>
      <visual>
        <origin xyz="0.049 -0 0.016" rpy="0 -0 -1.5708" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/part_1.stl" />
        </geometry>
        <material name="${prefix}part_1_material">
          <color rgba="0.615686 0.811765 0.929412 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0.049 -0 0.016" rpy="0 -0 -1.5708" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32_collision/part_1.stl" />
        </geometry>
      </collision>
      <visual>
        <origin xyz="0.0065 -0 0.029" rpy="0 -0 -1.5708" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/xeg_base.stl" />
        </geometry>
        <material name="${prefix}xeg_base_material">
          <color rgba="0.74902 0.74902 0.74902 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0.0065 -0 0.029" rpy="0 -0 -1.5708" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32_collision/xeg_base.stl" />
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 -1.5708" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/part_1__2.stl" />
        </geometry>
        <material name="${prefix}part_1_2_material">
          <color rgba="0.615686 0.811765 0.929412 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 -1.5708" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32_collision/part_1__2.stl" />
        </geometry>
      </collision>
    </link>
    <link name="${prefix}left_carriage_link">
      <inertial>
        <origin xyz="-0 -0.00376142 -0.00801771" rpy="0 0 0" />
        <mass value="0.0236002" />
        <inertia ixx="1.41079e-06" ixy="0" ixz="0" iyy="2.03222e-06" iyz="-7.27e-10" izz="7.93624e-07" />
      </inertial>
      <visual>
        <origin xyz="0 0.005 -0.0135" rpy="-3.14159 -0 -0" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/right_carriage.stl" />
        </geometry>
        <material name="${prefix}right_carriage_material">
          <color rgba="0 0 0 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0.005 -0.0135" rpy="-3.14159 -0 -0" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/right_carriage.stl" />
        </geometry>
      </collision>
      <visual>
        <origin xyz="-2.30037e-07 -0.004 -0.00315591" rpy="-1.5708 0 0" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/part_1__3.stl" />
        </geometry>
        <material name="${prefix}part_1_3_material">
          <color rgba="0.647059 0.647059 0.647059 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="-2.30037e-07 -0.004 -0.00315591" rpy="-1.5708 0 0" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32_collision/part_1__3.stl" />
        </geometry>
      </collision>
    </link>
    <link name="${prefix}right_carriage_link">
      <inertial>
        <origin xyz="-0 -0.00376142 -0.00801771" rpy="0 0 0" />
        <mass value="0.0236002" />
        <inertia ixx="1.41079e-06" ixy="-0" ixz="-0" iyy="2.03222e-06" iyz="-7.27e-10" izz="7.93624e-07" />
      </inertial>
      <visual>
        <origin xyz="-2.30037e-07 -0.004 -0.00315591" rpy="-1.5708 0 -0" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/part_1__3.stl" />
        </geometry>
        <material name="${prefix}part_1_4_material">
          <color rgba="0.647059 0.647059 0.647059 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="-2.30037e-07 -0.004 -0.00315591" rpy="-1.5708 0 -0" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32_collision/part_1__3.stl" />
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0.005 -0.0135" rpy="-3.14159 0 0" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/right_carriage.stl" />
        </geometry>
        <material name="${prefix}right_carriage_2_material">
          <color rgba="0 0 0 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0.005 -0.0135" rpy="-3.14159 0 0" />
        <geometry>
          <mesh filename="package://igus_rebel_description/meshes/xeg32/right_carriage.stl" />
        </geometry>
      </collision>
    </link>
    <!-- The ReBeL driver currently publishes arm states only. Lock the
         unactuated XEG joints in the planning model until a gripper controller
         publishes their states; this prevents an incomplete robot state. -->
    <xacro:if value="${lock_joints}">
      <joint name="${prefix}left_carriage_joint" type="fixed">
        <origin xyz="-0.0312 0.0334131 0.029" rpy="-1.5708 -1.5708 0" />
        <parent link="${prefix}base_link" />
        <child link="${prefix}left_carriage_link" />
      </joint>
      <joint name="${prefix}right_carriage_joint" type="fixed">
        <origin xyz="-0.0312 -0.0334131 0.029" rpy="1.5708 1.5708 0" />
        <parent link="${prefix}base_link" />
        <child link="${prefix}right_carriage_link" />
      </joint>
    </xacro:if>
    <xacro:unless value="${lock_joints}">
      <joint name="${prefix}left_carriage_joint" type="prismatic">
        <origin xyz="-0.0312 0.0334131 0.029" rpy="-1.5708 -1.5708 0" />
        <parent link="${prefix}base_link" />
        <child link="${prefix}left_carriage_link" />
        <axis xyz="0 0 1" />
        <limit effort="10" velocity="10" lower="-0.0116631" upper="0.00483688" />
      </joint>
      <joint name="${prefix}right_carriage_joint" type="prismatic">
        <origin xyz="-0.0312 -0.0334131 0.029" rpy="1.5708 1.5708 0" />
        <parent link="${prefix}base_link" />
        <child link="${prefix}right_carriage_link" />
        <axis xyz="0 0 1" />
        <limit effort="10" velocity="10" lower="-0.0116631" upper="0.00483688" />
        <mimic joint="${prefix}left_carriage_joint" multiplier="1.0" />
      </joint>
    </xacro:unless>
  </xacro:macro>
</robot>