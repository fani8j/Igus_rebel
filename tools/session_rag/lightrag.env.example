# Client settings for tools/session_rag/session_rag.py.
# Keep the server on loopback unless it has authenticated accounts and network controls.
LIGHTRAG_URL=http://127.0.0.1:9621
LIGHTRAG_API_KEY=replace-with-a-long-random-secret

